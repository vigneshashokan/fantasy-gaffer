EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# PostHog product analytics (US Cloud). Leave unset to disable analytics entirely.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry crash reporting. Leave unset to disable crash reporting entirely.
EXPO_PUBLIC_SENTRY_DSN=

# Sentry source-map upload — EAS BUILD ONLY (set as EAS secrets, NOT bundled):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Required for LOCAL native builds (`expo run:ios` / `run:android`).
# The Sentry plugin runs sentry-cli in an Xcode build phase on every build and
# FAILS it without an org + project. EAS covers this two ways — dev profiles set
# this flag, release profiles inject SENTRY_ORG/SENTRY_PROJECT via `environment`
# — but a local build never reads eas.json, so neither applies and the build
# dies at the last step with "A project ID or slug is required".
# Uploading source maps for a __DEV__ bundle is pointless anyway; Sentry never
# symbolicates those.
SENTRY_DISABLE_AUTO_UPLOAD=true
